# MyOGChat runtime configuration — copy to ~/.config/myogchat/env and chmod 600.
# Never commit the real file; this example only documents the variables.

# OpenCode Go API key (required).
OPENCODE_API_KEY=sk-replace-me

# Optional: Tavily API key — enables the Tavily web_search provider (Phase 2.4).
# TAVILY_API_KEY=tvly-replace-me

# Optional: Brave Search API key — enables the Brave web_search provider.
# BRAVE_API_KEY=brave-replace-me

# Optional: web-search provider selection (tavily|brave|ddg|auto, default auto).
# DuckDuckGo is keyless, so web_search works with no keys at all.
# MYOGCHAT_SEARCH_PROVIDER=auto
# Results per query, clamped to [1, 20] (default 5).
# MYOGCHAT_SEARCH_RESULTS=5
# DDG region / Brave country source (default us-en).
# MYOGCHAT_SEARCH_REGION=us-en
# Safe search: off|moderate|strict (default moderate).
# MYOGCHAT_SEARCH_SAFESEARCH=moderate

# Shared login token for the web UI (required). Generate with:
#   openssl rand -base64 24
MYOGCHAT_AUTH_TOKEN=replace-with-a-long-random-string

# Listen port (default 8787).
MYOGCHAT_PORT=8787

# Chat retention in days, clamped to [1, 60] (default 30).
MYOGCHAT_RETENTION_DAYS=30

# Optional: override the SQLite location.
# MYOGCHAT_DB=/home/pi/.local/share/myogchat/chat.db
