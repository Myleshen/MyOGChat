# MyOGChat runtime configuration — copy to ~/.config/myogchat/env and chmod 600.
# Never commit the real file; this example only documents the variables.

# OpenCode Go API key (required).
OPENCODE_API_KEY=sk-replace-me

# Optional: Tavily API key — enables the Tavily web_search provider (Phase 2.4).
# TAVILY_API_KEY=tvly-replace-me

# Optional: Brave Search API key — enables the Brave web_search provider.
# BRAVE_API_KEY=brave-replace-me

# Optional: web-search provider selection (tavily|brave|ddg|auto, default auto).
# DuckDuckGo is keyless, so web_search works with no keys at all.
# MYOGCHAT_SEARCH_PROVIDER=auto
# Results per query, clamped to [1, 20] (default 5).
# MYOGCHAT_SEARCH_RESULTS=5
# DDG region / Brave country source (default us-en).
# MYOGCHAT_SEARCH_REGION=us-en
# Safe search: off|moderate|strict (default moderate).
# MYOGCHAT_SEARCH_SAFESEARCH=moderate

# No shared login token: multi-user username/password auth replaced it.
# (MYOGCHAT_AUTH_TOKEN is obsolete and ignored.)

# Listen port (default 8787).
MYOGCHAT_PORT=8787

# Chat retention in days, clamped to [1, 60] (default 30).
MYOGCHAT_RETENTION_DAYS=30

# Optional: override the SQLite location.
# MYOGCHAT_DB=/home/pi/.local/share/myogchat/chat.db

# --- Code sandbox (Phase 2.6 Python / 2.7 Bash) ---
# Hard kill switch for run_bash / run_python (default on). Set 0/false/off to
# disable the tools entirely.
# MYOGCHAT_SANDBOX=1
# Docker CLI path (default /usr/bin/docker, falls back to $PATH).
# MYOGCHAT_DOCKER=/usr/bin/docker
# Dedicated bridge network and images (defaults shown). Provision the host once
# with: bash deploy/sandbox-setup.sh
# MYOGCHAT_SANDBOX_NETWORK=myogchat-sbx
# MYOGCHAT_SANDBOX_IMAGE_BASH=bash:5.3
# MYOGCHAT_SANDBOX_IMAGE_PYTHON=python:3.14-slim
# Per-call timeout (seconds), memory, CPUs and output cap.
# MYOGCHAT_SANDBOX_TIMEOUT=30
# MYOGCHAT_SANDBOX_MEMORY=256m
# MYOGCHAT_SANDBOX_CPUS=1
# MYOGCHAT_SANDBOX_MAX_OUTPUT=100000

# Image OCR (feature 2.5). On by default; set MYOGCHAT_OCR=0 to disable it
# entirely. OCR runs tesseract in a throwaway Docker container (build the image
# once with deploy/ocr-setup.sh). The admin can also toggle it in Settings.
# MYOGCHAT_OCR=1
# MYOGCHAT_OCR_IMAGE=myogchat-ocr
# MYOGCHAT_OCR_LANGS=eng
# MYOGCHAT_OCR_TIMEOUT=30s

# --- Speech (features 3.5 STT / 3.6 TTS) ---
# Persistent HTTP services (models stay warm), NOT Ollama. Provision the Pi-local
# defaults once with: bash deploy/speech-setup.sh  (or point the URLs at a
# Proxmox GPU shim — the Go client is OpenAI-compatible).
#
# STT: whisper.cpp whisper-server, POST /v1/audio/transcriptions. On by default;
# MYOGCHAT_STT=off disables it (the mic button hides).
# MYOGCHAT_STT=auto
# MYOGCHAT_STT_URL=http://127.0.0.1:8080
# MYOGCHAT_STT_MODEL=base.en
# MYOGCHAT_STT_LANGUAGE=            # optional ISO-639-1 hint ("en"); blank = auto
# MYOGCHAT_STT_TIMEOUT=120s
# MYOGCHAT_STT_KEY=                 # optional bearer token for a protected shim
#
# TTS: Piper (native) or an OpenAI-compatible /v1/audio/speech shim. On by
# default; MYOGCHAT_TTS=off disables it.
# MYOGCHAT_TTS=auto
# MYOGCHAT_TTS_URL=http://127.0.0.1:5000
# MYOGCHAT_TTS_VOICE=en_US-lessac-medium
# MYOGCHAT_TTS_FORMAT=openai        # openai | piper
# MYOGCHAT_TTS_MODEL=tts-1          # OpenAI model name (ignored by Piper)
# MYOGCHAT_TTS_TIMEOUT=30s
# MYOGCHAT_TTS_KEY=                 # optional bearer token for a protected shim
